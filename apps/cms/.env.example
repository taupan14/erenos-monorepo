# Salin menjadi apps/cms/.env.local (lokal) — di Vercel isi lewat Project Settings > Environment Variables

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL website publik — dipakai nanti untuk memicu revalidasi saat konten terbit
WEB_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
# Rahasia bersama CMS <-> web untuk endpoint revalidasi (string acak panjang; sama di kedua project)
REVALIDATE_SECRET=

BREVO_API_KEY=...
BREVO_SENDER_EMAIL=...        # alamat pengirim yang sudah diverifikasi di Brevo
BREVO_SENDER_NAME=Erenos Christian School   # opsional
BREVO_FOLDER_ID=1             # opsional, folder kontak di Brevo
BREVO_REPLY_TO=...            # opsional
