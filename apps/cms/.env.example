# Salin menjadi apps/cms/.env.local (lokal) — di Vercel isi lewat Project Settings > Environment Variables

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL website publik — dipakai nanti untuk memicu revalidasi saat konten terbit
WEB_URL=http://localhost:3000
# Rahasia bersama CMS <-> web untuk endpoint revalidasi (string acak panjang; sama di kedua project)
REVALIDATE_SECRET=
