# Salin menjadi apps/web/.env.local (lokal) — di Vercel isi lewat Project Settings > Environment Variables

# Dari `supabase start` (lokal) atau Dashboard > Project Settings > API (produksi)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Kunci publishable (sb_publishable_...) atau anon key lama — aman dipakai di browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL publik website (untuk metadata, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Rahasia bersama CMS <-> web untuk POST /api/revalidate (string acak panjang; harus sama dengan di apps/cms)
# Buat dengan: openssl rand -hex 32
REVALIDATE_SECRET=

